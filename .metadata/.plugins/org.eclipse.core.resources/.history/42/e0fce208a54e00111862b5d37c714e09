<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" isELIgnored="false" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/home.css">

<%@ include file="partials/navbar.jsp" %>

<!-- ================= HERO ================= -->
<div class="hero-section">
    <a href="${pageContext.request.contextPath}/products">
        <img src="${pageContext.request.contextPath}/assets/img/main_banner.jpg" alt="Aries Fashion Store Banner" class="hero-banner-img">
    </a>
</div>

<!-- ================= CATEGORY ================= -->
<div class="container category-section">

    <h2>Shop by Category</h2>

    <div class="categories">

        <c:forEach var="c" items="${categories}">

            <a href="${pageContext.request.contextPath}/category?id=${c.categoryId}" class="category-card">
                <span>${c.categoryName}</span>
            </a>

        </c:forEach>

    </div>

</div>

<!-- ================= PRODUCTS ================= -->
<div class="container products-section">

    <h2>Latest Products</h2>

    <div class="products-grid">

        <c:forEach var="p" items="${products}">
            <div class="product-card">

                <a href="${pageContext.request.contextPath}/product-details?id=${p.productId}">
                    <img src="${pageContext.request.contextPath}/assets/images/${p.imageUrl}" 
                         alt="${p.productName}" />
                    <h3>${p.productName}</h3>
                </a>

                <p>${p.discountPercentage}% OFF</p>

                <a href="${pageContext.request.contextPath}/product-details?id=${p.productId}">
                    <button class="btn">View</button>
                </a>

            </div>
        </c:forEach>

    </div>

</div>

<%@ include file="partials/footer.jsp" %>