<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/category.css">

<%@ include file="partials/navbar.jsp" %>

<div class="category-container">

    <h2 class="category-title">🛍️ Category Products</h2>

    <div class="products-grid">

        <!-- PRODUCTS AVAILABLE -->
        <c:if test="${not empty products}">
            <c:forEach var="p" items="${products}">

                <div class="product-card">

                    <!-- IMAGE + BADGE -->
                    <div class="product-img">
                        <img src="${pageContext.request.contextPath}/assets/images/${p.imageUrl}" 
                             alt="${p.productName}" />

                        <span class="discount-badge">
                            ${p.discountPercentage}% OFF
                        </span>
                    </div>

                    <!-- DETAILS -->
                    <div class="product-info">

                        <h3>${p.productName}</h3>

                        <!-- ACTION BUTTONS -->
                        <div class="product-actions">

                            <a href="${pageContext.request.contextPath}/product-details?id=${p.productId}" 
                               class="view-btn">
                                View
                            </a>

                            <form action="${pageContext.request.contextPath}/cart" method="post">
                                <input type="hidden" name="action" value="add"/>
                                <input type="hidden" name="productId" value="${p.productId}" />

                                <button type="submit" class="cart-btn">
                                    Add to Cart
                                </button>
                            </form>

                        </div>

                    </div>

                </div>

            </c:forEach>
        </c:if>

        <!-- EMPTY STATE -->
        <c:if test="${empty products}">
            <div class="no-products">
                <h3>No products found 😢</h3>
                <a href="${pageContext.request.contextPath}/products" class="shop-btn">
                    Browse All Products
                </a>
            </div>
        </c:if>

    </div>

</div>

<%@ include file="partials/footer.jsp" %>