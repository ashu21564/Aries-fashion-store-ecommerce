package com.ariesfashionstore.dao.impl;

import com.ariesfashionstore.dao.ProductDAO;
import com.ariesfashionstore.model.Product;
import com.ariesfashionstore.util.DBConnection;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class ProductDAOImpl implements ProductDAO {

    // ================= SQL CONSTANTS =================

    private static final String ADD_PRODUCT_SQL =
            "INSERT INTO products (category_id, product_name, description, discount_percentage, image_url, is_active) VALUES (?, ?, ?, ?, ?, ?)";

    private static final String UPDATE_PRODUCT_SQL =
            "UPDATE products SET category_id=?, product_name=?, description=?, discount_percentage=?, image_url=?, is_active=? WHERE product_id=?";

    private static final String DELETE_PRODUCT_SQL =
            "DELETE FROM products WHERE product_id=?";

    private static final String GET_PRODUCT_BY_ID_SQL =
            "SELECT * FROM products WHERE product_id=?";

    private static final String GET_ALL_PRODUCTS_SQL =
            "SELECT * FROM products";

    private static final String GET_ACTIVE_PRODUCTS_SQL =
            "SELECT * FROM products WHERE is_active=1";

    private static final String GET_PRODUCTS_BY_CATEGORY_SQL =
            "SELECT * FROM products WHERE category_id=? AND is_active=1";

    private static final String SEARCH_PRODUCTS_SQL =
            "SELECT * FROM products WHERE product_name LIKE ? AND is_active=1";

    private static final String LATEST_PRODUCTS_SQL =
            "SELECT * FROM products ORDER BY product_id DESC LIMIT ?";

    private static final String RELATED_PRODUCTS_SQL =
            "SELECT * FROM products WHERE category_id=? AND product_id != ? LIMIT ?";

    // ================= ADD =================

    @Override
    public boolean addProduct(Product product) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(ADD_PRODUCT_SQL)) {

            ps.setInt(1, product.getCategoryId());
            ps.setString(2, product.getProductName());
            ps.setString(3, product.getDescription());
            ps.setDouble(4, product.getDiscountPercentage());
            ps.setString(5, product.getImageUrl());
            ps.setBoolean(6, product.isActive());

            return ps.executeUpdate() > 0;

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return false;
    }

    // ================= UPDATE =================

    @Override
    public boolean updateProduct(Product product) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(UPDATE_PRODUCT_SQL)) {

            ps.setInt(1, product.getCategoryId());
            ps.setString(2, product.getProductName());
            ps.setString(3, product.getDescription());
            ps.setDouble(4, product.getDiscountPercentage());
            ps.setString(5, product.getImageUrl());
            ps.setBoolean(6, product.isActive());
            ps.setInt(7, product.getProductId());

            return ps.executeUpdate() > 0;

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return false;
    }

    // ================= DELETE =================

    @Override
    public boolean deleteProduct(int productId) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(DELETE_PRODUCT_SQL)) {

            ps.setInt(1, productId);

            return ps.executeUpdate() > 0;

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return false;
    }

    // ================= GET BY ID =================

    @Override
    public Product getProductById(int productId) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(GET_PRODUCT_BY_ID_SQL)) {

            ps.setInt(1, productId);

            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                return mapResultSetToProduct(rs);
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return null;
    }

    // ================= GET ALL =================

    @Override
    public List<Product> getAllProducts() {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(GET_ALL_PRODUCTS_SQL);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= ACTIVE =================

    @Override
    public List<Product> getAllActiveProducts() {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(GET_ACTIVE_PRODUCTS_SQL);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= CATEGORY =================

    @Override
    public List<Product> getProductsByCategory(int categoryId) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(GET_PRODUCTS_BY_CATEGORY_SQL)) {

            ps.setInt(1, categoryId);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= SEARCH =================

    @Override
    public List<Product> searchProducts(String keyword) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(SEARCH_PRODUCTS_SQL)) {

            ps.setString(1, "%" + keyword + "%");

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= LATEST =================

    @Override
    public List<Product> getLatestProducts(int limit) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(LATEST_PRODUCTS_SQL)) {

            ps.setInt(1, limit);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= RELATED =================

    @Override
    public List<Product> getRelatedProducts(int productId, int categoryId) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(RELATED_PRODUCTS_SQL)) {

            ps.setInt(1, categoryId);
            ps.setInt(2, productId);
            ps.setInt(3, 4);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (SQLException e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= PRICE RANGE =================

    @Override
    public List<Product> getProductsByPriceRange(double minPrice, double maxPrice) {

        String sql = "SELECT * FROM products WHERE discount_percentage BETWEEN ? AND ? AND is_active=1";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setDouble(1, minPrice);
            ps.setDouble(2, maxPrice);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= FILTERED =================

    @Override
    public List<Product> getFilteredProducts(int categoryId, double minPrice, double maxPrice) {

        String sql = "SELECT * FROM products WHERE category_id=? AND discount_percentage BETWEEN ? AND ? AND is_active=1";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, categoryId);
            ps.setDouble(2, minPrice);
            ps.setDouble(3, maxPrice);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= SORT ASC =================

    @Override
    public List<Product> getProductsSortedByPriceAsc() {
        String sql = "SELECT * FROM products WHERE is_active=1 ORDER BY discount_percentage ASC";
        return executeListQuery(sql);
    }

    // ================= SORT DESC =================

    @Override
    public List<Product> getProductsSortedByPriceDesc() {
        String sql = "SELECT * FROM products WHERE is_active=1 ORDER BY discount_percentage DESC";
        return executeListQuery(sql);
    }

    // ================= HELPER =================

    private List<Product> executeListQuery(String sql) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                list.add(mapResultSetToProduct(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    private Product mapResultSetToProduct(ResultSet rs) throws SQLException {

        Product p = new Product();

        p.setProductId(rs.getInt("product_id"));
        p.setCategoryId(rs.getInt("category_id"));
        p.setProductName(rs.getString("product_name"));
        p.setDescription(rs.getString("description"));
        p.setDiscountPercentage(rs.getDouble("discount_percentage"));
        p.setImageUrl(rs.getString("image_url"));
        p.setActive(rs.getBoolean("is_active"));

        return p;
    }
}