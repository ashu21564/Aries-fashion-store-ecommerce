/* ===== GLOBAL ===== */
body {
    background: #0f0f0f;
    font-family: 'Segoe UI', sans-serif;
    color: #fff;
}

/* ===== HERO ===== */
.hero-section {
    position: relative;
    width: 100%;
    height: 420px;
    overflow: hidden;
}

.hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
}

/* OVERLAY TEXT */
.hero-content {
    position: absolute;
    top: 50%;
    left: 8%;
    transform: translateY(-50%);
}

.hero-content h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

.hero-content p {
    color: #ccc;
    margin-bottom: 20px;
}

.hero-btn {
    padding: 12px 20px;
    background: linear-gradient(135deg, #ff4da6, #c2185b);
    border-radius: 8px;
    color: #fff;
    text-decoration: none;
    transition: 0.3s;
}

.hero-btn:hover {
    transform: scale(1.05);
}

/* ===== CATEGORY ===== */
.category-section {
    width: 90%;
    margin: 60px auto;
    text-align: center;
}

.category-section h2 {
    font-size: 28px;
    margin-bottom: 25px;
}

.categories {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 20px;
}

.category-card {
    padding: 15px 30px;
    background: #1e1e1e;
    border-radius: 10px;
    text-decoration: none;
    color: #fff;
    border: 1px solid #333;
    transition: 0.3s;
}

.category-card:hover {
    background: #ff4da6;
    transform: translateY(-5px);
}

/* ===== PRODUCTS ===== */
.products-section {
    width: 90%;
    margin: 60px auto;
    text-align: center;
}

.products-section h2 {
    font-size: 28px;
    margin-bottom: 25px;
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

/* CARD */
.product-card {
    background: #1e1e1e;
    border-radius: 12px;
    overflow: hidden;
    transition: 0.3s;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.6);
}

/* IMAGE */
.product-img {
    position: relative;
}

.product-img img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

/* BADGE */
.discount-badge {
    position: absolute;
    top: 10px;
    left: 10px;
    background: #ff4da6;
    padding: 5px 10px;
    font-size: 12px;
    border-radius: 5px;
}

/* INFO */
.product-info {
    padding: 15px;
    text-align: center;
}

.product-info h3 {
    margin-bottom: 10px;
}

/* BUTTON */
.view-btn {
    display: inline-block;
    padding: 8px 12px;
    background: #ff4da6;
    border-radius: 6px;
    color: #fff;
    text-decoration: none;
}

.view-btn:hover {
    background: #c2185b;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .hero-section {
        height: 300px;
    }

    .hero-content h1 {
        font-size: 28px;
    }
}