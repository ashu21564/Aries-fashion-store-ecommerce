<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">

<%@ include file="partials/navbar.jsp" %>

<div class="container">

    <c:if test="${not empty product}">

        <div style="display:flex; gap:40px; margin-top:40px;">

            <!-- ================= IMAGE ================= -->
            <div>
                <img src="${pageContext.request.contextPath}/assets/images/${product.imageUrl}"
                     style="width:350px; border-radius:10px;" />
            </div>

            <!-- ================= DETAILS ================= -->
            <div>

                <h2>${product.productName}</h2>

                <p>${product.description}</p>

                <h3 style="color:#C71585;">
                    ${product.discountPercentage}% OFF
                </h3>

                <!-- ================= ADD TO CART FORM ================= -->
                <form action="${pageContext.request.contextPath}/cart" method="post">

                    <!-- 🔥 REQUIRED FOR SINGLE SERVLET -->
                    <input type="hidden" name="action" value="add"/>
                    <input type="hidden" name="productId" value="${product.productId}" />

                    <!-- SIZE -->
                    <label>Select Size:</label><br><br>

                    <select name="sizeLabel" required>

                        <c:forEach var="v" items="${variants}">
                            <option value="${v.sizeLabel}">
                                ${v.sizeLabel} (Stock: ${v.stockQuantity})
                            </option>
                        </c:forEach>

                    </select>

                    <br><br>

                    <!-- BUTTON -->
                    <button type="submit" class="btn">Add to Cart</button>

                </form>

            </div>

        </div>

    </c:if>

</div>

<%@ include file="partials/footer.jsp" %>