<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">

<%@ include file="partials/navbar.jsp" %>

<div class="container" style="margin-top: 40px;">

    <h2>Your Cart</h2>

    <c:if test="${empty cartItems}">
        <p>Your cart is empty 🛒</p>
        <a href="${pageContext.request.contextPath}/products" class="btn">Shop Now</a>
    </c:if>

    <c:if test="${not empty cartItems}">

        <table style="width:100%; margin-top:20px; border-collapse: collapse;">

            <tr style="background:#111; color:white;">
                <th style="padding:10px;">Product</th>
                <th>Size</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Total</th>
                <th>Action</th>
            </tr>

            <!-- 🔥 TOTAL CALCULATION -->
            <c:set var="grandTotal" value="0"/>

            <c:forEach var="item" items="${cartItems}">

                <c:set var="itemTotal" value="${item.quantity * item.unitPrice}"/>
                <c:set var="grandTotal" value="${grandTotal + itemTotal}"/>

                <tr style="text-align:center; border-bottom:1px solid #ccc;">

                    <!-- PRODUCT NAME -->
                    <td style="padding:10px;">${item.productName}</td>

                    <!-- SIZE -->
                    <td>${item.sizeLabel}</td>

                    <!-- PRICE -->
                    <td>₹ ${item.unitPrice}</td>

                    <!-- 🔄 UPDATE QUANTITY -->
                    <td>
                        <form action="${pageContext.request.contextPath}/cart" method="post" style="display:flex; gap:5px; justify-content:center;">

                            <input type="hidden" name="action" value="update"/>
                            <input type="hidden" name="cartItemId" value="${item.cartItemId}"/>

                            <input type="number" name="quantity" value="${item.quantity}" min="1" style="width:60px;"/>

                            <button type="submit">Update</button>

                        </form>
                    </td>

                    <!-- ITEM TOTAL -->
                    <td>₹ ${itemTotal}</td>

                    <!-- ❌ REMOVE -->
                    <td>
                        <a href="${pageContext.request.contextPath}/cart?action=remove&cartItemId=${item.cartItemId}"
                           style="color:red; text-decoration:none;">
                            Remove
                        </a>
                    </td>

                </tr>

            </c:forEach>

        </table>

        <!-- 💰 GRAND TOTAL -->
        <div style="margin-top:30px; text-align:right;">

            <h3>Total: ₹ ${grandTotal}</h3>

            <!-- 🚀 CHECKOUT BUTTON -->
            <a href="${pageContext.request.contextPath}/checkout" class="btn">
                Proceed to Checkout
            </a>

        </div>

    </c:if>

</div>

<%@ include file="partials/footer.jsp" %>