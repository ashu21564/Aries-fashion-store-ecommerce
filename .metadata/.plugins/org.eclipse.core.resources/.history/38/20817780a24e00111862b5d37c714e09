/* ================= CART PAGE ================= */

.container h2 {
    color: #ffffff;
    margin-bottom: 20px;
}

/* TABLE */
.cart-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    background: #1e1e1e;
    border-radius: 10px;
    overflow: hidden;
}

/* HEADER */
.cart-table th {
    background: #8B0000; /* Dark Red */
    color: #ffffff;
    padding: 12px;
    text-align: center;
}

/* ROWS */
.cart-table td {
    padding: 12px;
    text-align: center;
    color: #ffffff;
    border-bottom: 1px solid #333;
}

/* HOVER EFFECT */
.cart-table tr:hover {
    background: #2a2a2a;
}

/* INPUT */
.cart-table input[type="number"] {
    width: 60px;
    padding: 5px;
    border-radius: 5px;
    border: none;
    text-align: center;
}

/* BUTTON */
.cart-table button {
    padding: 6px 10px;
    background: #C71585; /* Magenta */
    border: none;
    color: #fff;
    border-radius: 5px;
    cursor: pointer;
}

.cart-table button:hover {
    background: #8B0000;
}

/* REMOVE LINK */
.cart-table a {
    color: #ff4d4d;
    text-decoration: none;
}

.cart-table a:hover {
    text-decoration: underline;
}

/* TOTAL SECTION */
.cart-total {
    margin-top: 30px;
    text-align: right;
    color: #ffffff;
}

.cart-total h3 {
    margin-bottom: 15px;
}

/* CHECKOUT BUTTON */
.checkout-btn {
    padding: 10px 20px;
    background: #C71585;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    transition: 0.3s;
}

.checkout-btn:hover {
    background: #8B0000;
}

/* EMPTY CART */
.empty-cart {
    color: #ffffff;
    margin-top: 20px;
}

.empty-cart a {
    display: inline-block;
    margin-top: 10px;
    padding: 10px 15px;
    background: #C71585;
    color: #fff;
    text-decoration: none;
    border-radius: 5px;
}

.empty-cart a:hover {
    background: #8B0000;
}