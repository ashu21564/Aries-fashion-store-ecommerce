<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/cart.css">

<%@ include file="partials/navbar.jsp" %>

<div class="cart-container">

    <h2 class="cart-title">🛒 Your Shopping Cart</h2>

    <!-- EMPTY CART -->
    <c:if test="${empty cartItems}">
        <div class="empty-cart">
            <h3>Your cart is empty</h3>
            <p>Looks like you haven’t added anything yet.</p>
            <a href="${pageContext.request.contextPath}/products" class="shop-btn">
                🛍️ Start Shopping
            </a>
        </div>
    </c:if>

    <!-- CART ITEMS -->
    <c:if test="${not empty cartItems}">

        <div class="cart-layout">

            <!-- LEFT SIDE (ITEMS) -->
            <div class="cart-items">

                <c:set var="grandTotal" value="0"/>

                <c:forEach var="item" items="${cartItems}">

                    <c:set var="itemTotal" value="${item.quantity * item.unitPrice}"/>
                    <c:set var="grandTotal" value="${grandTotal + itemTotal}"/>

                    <div class="cart-card">

                        <!-- PRODUCT IMAGE -->
                        <div class="cart-image">
                            <img src="${pageContext.request.contextPath}/assets/images/default.png" alt="product">
                        </div>

                        <!-- DETAILS -->
                        <div class="cart-details">
                            <h3>${item.productName}</h3>
                            <p class="size">Size: ${item.sizeLabel}</p>
                            <p class="price">₹ ${item.unitPrice}</p>
                        </div>

                        <!-- QUANTITY -->
                        <div class="cart-qty">
                            <form action="${pageContext.request.contextPath}/cart" method="post">
                                <input type="hidden" name="action" value="update"/>
                                <input type="hidden" name="cartItemId" value="${item.cartItemId}"/>

                                <input type="number" name="quantity" value="${item.quantity}" min="1"/>
                                <button type="submit">Update</button>
                            </form>
                        </div>

                        <!-- TOTAL -->
                        <div class="cart-total-item">
                            ₹ ${itemTotal}
                        </div>

                        <!-- REMOVE -->
                        <div class="cart-remove">
                            <a href="${pageContext.request.contextPath}/cart?action=remove&cartItemId=${item.cartItemId}">
                                ❌ Remove
                            </a>
                        </div>

                    </div>

                </c:forEach>

            </div>

            <!-- RIGHT SIDE (SUMMARY) -->
            <div class="cart-summary">

                <h3>Price Details</h3>

                <div class="summary-row">
                    <span>Total Items</span>
                    <span>${fn:length(cartItems)}</span>
                </div>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>₹ ${grandTotal}</span>
                </div>

                <div class="summary-row">
                    <span>Delivery</span>
                    <span class="free">FREE</span>
                </div>

                <hr>

                <div class="summary-total">
                    <span>Total Amount</span>
                    <span>₹ ${grandTotal}</span>
                </div>

                <a href="${pageContext.request.contextPath}/checkout" class="checkout-btn">
                    Proceed to Checkout →
                </a>

            </div>

        </div>

    </c:if>

</div>

<%@ include file="partials/footer.jsp" %>