<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/products.css">

<%@ include file="partials/navbar.jsp" %>

<div class="container">

    <h2>Category Products</h2>

    <div class="products-grid">

        <c:if test="${not empty products}">
            <c:forEach var="p" items="${products}">
                <div class="product-card">

                    <!-- 🔥 FIXED IMAGE SIZE -->
                    <div class="product-img">
                        <img src="${pageContext.request.contextPath}/assets/images/${p.imageUrl}" 
                             alt="${p.productName}"
                             onerror="this.src='${pageContext.request.contextPath}/assets/images/default.png'" />
                    </div>

                    <h3>${p.productName}</h3>

                    <p>${p.discountPercentage}% OFF</p>

                    <form action="${pageContext.request.contextPath}/add-to-cart" method="post">
                        <input type="hidden" name="productId" value="${p.productId}" />
                        <button type="submit" class="btn">Add to Cart</button>
                    </form>

                </div>
            </c:forEach>
        </c:if>

        <c:if test="${empty products}">
            <p>No products found in this category</p>
        </c:if>

    </div>

</div>

<%@ include file="partials/footer.jsp" %>