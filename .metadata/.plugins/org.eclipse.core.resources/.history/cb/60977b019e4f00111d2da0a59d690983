package com.ariesfashionstore.dao.impl;

import com.ariesfashionstore.dao.ProductDAO;
import com.ariesfashionstore.model.Product;
import com.ariesfashionstore.util.DBConnection;

import java.sql.*;
import java.util.ArrayList;
import java.util.List;

public class ProductDAOImpl implements ProductDAO {

    // ================= SQL =================

    private static final String ADD_PRODUCT_SQL =
            "INSERT INTO products (category_id, product_name, description, color, price, discount_percentage, image_url, is_active) VALUES (?, ?, ?, ?, ?, ?, ?, ?)";

    private static final String UPDATE_PRODUCT_SQL =
            "UPDATE products SET category_id=?, product_name=?, description=?, color=?, price=?, discount_percentage=?, image_url=?, is_active=? WHERE product_id=?";

    private static final String GET_ALL_ACTIVE =
            "SELECT * FROM products WHERE is_active=1";

    private static final String GET_BY_ID =
            "SELECT * FROM products WHERE product_id=?";

    // ================= ADD =================
    @Override
    public boolean addProduct(Product product) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(ADD_PRODUCT_SQL)) {

            ps.setInt(1, product.getCategoryId());
            ps.setString(2, product.getProductName());
            ps.setString(3, product.getDescription());
            ps.setString(4, product.getColor());
            ps.setDouble(5, product.getPrice());
            ps.setDouble(6, product.getDiscountPercentage());
            ps.setString(7, product.getImageUrl());
            ps.setBoolean(8, product.isActive());

            return ps.executeUpdate() > 0;

        } catch (Exception e) {
            e.printStackTrace();
        }
        return false;
    }

    // ================= UPDATE =================
    @Override
    public boolean updateProduct(Product product) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(UPDATE_PRODUCT_SQL)) {

            ps.setInt(1, product.getCategoryId());
            ps.setString(2, product.getProductName());
            ps.setString(3, product.getDescription());
            ps.setString(4, product.getColor());
            ps.setDouble(5, product.getPrice());
            ps.setDouble(6, product.getDiscountPercentage());
            ps.setString(7, product.getImageUrl());
            ps.setBoolean(8, product.isActive());
            ps.setInt(9, product.getProductId());

            return ps.executeUpdate() > 0;

        } catch (Exception e) {
            e.printStackTrace();
        }
        return false;
    }

    // ================= DELETE =================
    @Override
    public boolean deleteProduct(int productId) {

        String sql = "DELETE FROM products WHERE product_id=?";

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, productId);
            return ps.executeUpdate() > 0;

        } catch (Exception e) {
            e.printStackTrace();
        }

        return false;
    }

    // ================= GET BY ID =================
    @Override
    public Product getProductById(int productId) {

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(GET_BY_ID)) {

            ps.setInt(1, productId);
            ResultSet rs = ps.executeQuery();

            if (rs.next()) {
                return map(rs);
            }

        } catch (Exception e) {
            e.printStackTrace();
        }
        return null;
    }

    // ================= GET ALL =================
    @Override
    public List<Product> getAllProducts() {
        return execute("SELECT * FROM products");
    }

    // ================= GET ACTIVE =================
    @Override
    public List<Product> getAllActiveProducts() {
        return execute(GET_ALL_ACTIVE);
    }

    // ================= SEARCH =================
    @Override
    public List<Product> searchProducts(String keyword) {

        String sql = "SELECT * FROM products WHERE product_name LIKE ? AND is_active=1";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setString(1, "%" + keyword + "%");

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= CATEGORY =================
    @Override
    public List<Product> getProductsByCategory(int categoryId) {

        String sql = "SELECT * FROM products WHERE category_id=? AND is_active=1";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, categoryId);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= PRICE RANGE =================
    @Override
    public List<Product> getProductsByPriceRange(double minPrice, double maxPrice) {

        String sql = "SELECT * FROM products WHERE price BETWEEN ? AND ? AND is_active=1";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setDouble(1, minPrice);
            ps.setDouble(2, maxPrice);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= FILTERED =================
    @Override
    public List<Product> getFilteredProducts(int categoryId, double minPrice, double maxPrice) {

        String sql = "SELECT * FROM products WHERE is_active=1 AND category_id=? AND price BETWEEN ? AND ?";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, categoryId);
            ps.setDouble(2, minPrice);
            ps.setDouble(3, maxPrice);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= SORT =================
    @Override
    public List<Product> getProductsSortedByPriceAsc() {
        return execute("SELECT * FROM products WHERE is_active=1 ORDER BY price ASC");
    }

    @Override
    public List<Product> getProductsSortedByPriceDesc() {
        return execute("SELECT * FROM products WHERE is_active=1 ORDER BY price DESC");
    }

    // ================= LATEST =================
    @Override
    public List<Product> getLatestProducts(int limit) {

        String sql = "SELECT * FROM products WHERE is_active=1 ORDER BY product_id DESC LIMIT ?";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, limit);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= RELATED =================
    @Override
    public List<Product> getRelatedProducts(int productId, int categoryId) {

        String sql = "SELECT * FROM products WHERE category_id=? AND product_id != ? AND is_active=1 LIMIT 4";

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql)) {

            ps.setInt(1, categoryId);
            ps.setInt(2, productId);

            ResultSet rs = ps.executeQuery();

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= COMMON EXECUTOR =================
    private List<Product> execute(String sql) {

        List<Product> list = new ArrayList<>();

        try (Connection conn = DBConnection.getConnection();
             PreparedStatement ps = conn.prepareStatement(sql);
             ResultSet rs = ps.executeQuery()) {

            while (rs.next()) {
                list.add(map(rs));
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return list;
    }

    // ================= MAPPER =================
    private Product map(ResultSet rs) throws SQLException {

        Product p = new Product();

        p.setProductId(rs.getInt("product_id"));
        p.setCategoryId(rs.getInt("category_id"));
        p.setProductName(rs.getString("product_name"));
        p.setDescription(rs.getString("description"));
        p.setColor(rs.getString("color"));
        p.setPrice(rs.getDouble("price"));
        p.setDiscountPercentage(rs.getDouble("discount_percentage"));
        p.setImageUrl(rs.getString("image_url"));
        p.setActive(rs.getBoolean("is_active"));

        return p;
    }
}